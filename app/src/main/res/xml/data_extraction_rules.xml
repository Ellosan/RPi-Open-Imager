<?xml version="1.0" encoding="utf-8"?>
<!-- Customisation settings hold password hashes and a Wi-Fi PSK, so nothing leaves the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
